{
  "manifest_version": 3,
  "name": "Portal PDF Downloader",
  "version": "1.0.0",
  "description": "Detects and downloads the PDF currently open in a supported portal.",
  "permissions": ["downloads", "activeTab", "scripting"],
  "host_permissions": ["https://srppn.chihuahua.gob.mx/*"],
  "action": {
    "default_title": "Descargar el PDF abierto",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
